{
  // Dibs 디버그 설정
  //
  // 가장 많이 쓸 것: "🚀 전체 (API + Web)" — F5 한 번으로 둘 다 뜨고, 양쪽 모두 중단점이 걸린다.
  //
  // API 를 tsx 로 직접 띄우지 않는 이유: tsx(esbuild)는 emitDecoratorMetadata 를 만들지 않는다.
  // NestJS 의 생성자 주입은 그 메타데이터로 타입을 읽으므로, tsx 로 띄우면 부팅하자마자
  // "Nest can't resolve dependencies" 로 죽는다. 그래서 nest CLI(tsc) 로 컴파일해 띄우고,
  // autoAttachChildProcesses 로 자식 node 프로세스에 디버거를 붙인다.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (NestJS)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "pnpm",
      "windows": { "runtimeExecutable": "pnpm.cmd" },
      "runtimeArgs": ["run", "start:debug"],
      "envFile": "${workspaceFolder}/apps/api/.env",
      "console": "integratedTerminal",
      // nest CLI 는 실제 서버를 자식 프로세스로 띄운다. 이게 없으면 중단점이 안 걸린다.
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "presentation": { "group": "1_apps", "order": 1 }
    },
    {
      "name": "Web (Next.js)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "pnpm",
      "windows": { "runtimeExecutable": "pnpm.cmd" },
      "runtimeArgs": ["run", "dev"],
      "envFile": "${workspaceFolder}/apps/web/.env.local",
      "console": "integratedTerminal",
      // 서버 컴포넌트·라우트 핸들러는 이 프로세스에서 돈다. 브라우저 쪽 중단점은
      // 아래 "Web: 브라우저" 를 함께 붙이거나, 컴파운드 구성을 쓰면 자동으로 붙는다.
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "serverReadyAction": {
        "pattern": "-\\s+Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "presentation": { "group": "1_apps", "order": 2 }
    },
    {
      "name": "Web: 브라우저만 붙이기",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web",
      // Next 의 소스맵 경로를 실제 파일로 되돌린다. 없으면 중단점이 회색으로 남는다.
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "webpack://*": "${webRoot}/*"
      },
      "presentation": { "group": "1_apps", "order": 3 }
    },

    {
      "name": "시드 실행 (db:seed)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      "runtimeArgs": ["tsx", "prisma/seed.ts"],
      "envFile": "${workspaceFolder}/apps/api/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "2_db", "order": 1 }
    },

    {
      "name": "단위 테스트 (전체)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      "runtimeArgs": ["jest", "--runInBand", "--passWithNoTests"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "3_test", "order": 1 }
    },
    {
      "name": "단위 테스트 (열려 있는 파일)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      // --runInBand 가 핵심이다. 워커 프로세스로 흩어지면 중단점이 안 걸린다.
      "runtimeArgs": ["jest", "--runInBand", "--testPathPattern", "${relativeFile}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "3_test", "order": 2 }
    },
    {
      "name": "통합 테스트 (DB 필요)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      "runtimeArgs": ["jest", "-c", "jest.integration.config.js", "--runInBand"],
      "envFile": "${workspaceFolder}/apps/api/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "3_test", "order": 3 }
    },
    {
      "name": "shared 테스트 (vitest)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/shared",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      "runtimeArgs": ["vitest", "run", "--no-file-parallelism"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "3_test", "order": 4 }
    }
  ],

  "compounds": [
    {
      "name": "🚀 전체 (API + Web)",
      "configurations": ["API (NestJS)", "Web (Next.js)"],
      "stopAll": true,
      "presentation": { "group": "0_all", "order": 1 }
    }
  ]
}
