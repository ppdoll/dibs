{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS는 tsc로 CommonJS를 뽑는다. node_modules 안의 .ts는 컴파일하지 않으므로
    // 이 패키지는 반드시 JS로 빌드돼 있어야 API가 런타임에 불러올 수 있다.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
