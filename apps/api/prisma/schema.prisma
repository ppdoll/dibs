// Dibs — 데이터 모델
//
// datasource가 URL을 둘로 나눠 쓰는 이유:
//   url       — pooled(pgbouncer) 주소. 서버리스 런타임이 쓴다.
//   directUrl — 직결 주소. 마이그레이션에만 쓴다(pgbouncer 뒤에서는 DDL이 안 된다).
//
// 제품 규칙의 근거는 docs/DECISIONS.md 를 보라.

generator client {
  provider = "prisma-client-js"
  // postgresqlExtensions: datasource 의 extensions 를 쓰기 위한 프리뷰 플래그.
  // 없으면 `migrate dev` 가 만드는 **섀도 DB** 에 확장이 안 깔려
  //   ERROR: operator class "gin_trgm_ops" does not exist for access method "gin"
  // 로 마이그레이션 검증이 실패한다. 실제 DB 에는 있는데 섀도에만 없어서 헷갈리기 쉽다.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

  // pg_trgm  — 한글 부분일치 검색(검색 모듈의 GIN 인덱스)
  // pgcrypto — 감사 로그 해시 체인의 digest()
  extensions = [pg_trgm, pgcrypto]
}

