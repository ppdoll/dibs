# =============================================================================
# Dibs — 환경변수 예시
#
# ⚠ 이 파일은 **저장소에 커밋된다.** 실제 값을 절대 여기 적지 말 것.
#   진짜 값은 apps/api/.env 에만 둔다(.gitignore 로 제외됨).
#
# 사용법 (★ 루트에 .env 를 두면 아무도 안 읽는다 — 각 앱 디렉터리에 놓아야 한다):
#
#   cp .env.example apps/api/.env
#   echo 'NEXT_PUBLIC_API_URL="http://localhost:3001"' > apps/web/.env.local
#
#   NestJS 의 ConfigModule 과 Prisma CLI 는 cwd(= apps/api)의 .env 를,
#   Next.js 는 apps/web 의 .env.local 을 읽는다. 저장소 루트는 어느 쪽도 보지 않는다.
#   웹에 필요한 값은 NEXT_PUBLIC_API_URL 하나뿐이므로 시크릿을 web 쪽에 복사하지 않는다.
#
# [필수]  없으면 API 가 부팅 시점에 터진다 (apps/api/src/config/env.schema.ts).
#         런타임 500 으로 흩어지지 않게 일부러 일찍 터뜨린다.
# [선택]  개발 중에는 비워도 된다. 그 기능만 꺼진 채로 앱은 뜬다.
# [보안]  없으면 해당 엔드포인트가 열리는 게 아니라 **닫힌다**(fail closed).
#
# 자세한 절차는 docs/RUNNING.md, 배포는 docs/DEPLOY.md 를 보세요.
# =============================================================================


# ─── 런타임 ──────────────────────────────────────────────────────────────────
# [선택] development | test | production. 기본 development.
NODE_ENV="development"
# [선택] API 포트. 기본 3001. 웹은 3000 고정(apps/web/package.json).
PORT="3001"


# ─── 데이터베이스 (Vercel Postgres / Neon / 로컬 Postgres) ────────────────────
# [필수] 런타임이 쓰는 **풀링(pgbouncer)** 주소. 서버리스는 인스턴스가 여럿이라 직결하면 커넥션이 마른다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dibs?sslmode=require&pgbouncer=true&connection_limit=1"
# [필수에 준함] 마이그레이션·001_constraints.sql 전용 **직결** 주소.
#   pgbouncer transaction 모드 뒤에서는 DDL 과 advisory lock 이 동작하지 않는다.
#   로컬 Postgres 처럼 풀러가 없으면 DATABASE_URL 과 같은 값을 넣으면 된다.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dibs?sslmode=require"
# [선택] migrate dev 가 쓰는 섀도 DB. 확장(pg_trgm·pgcrypto)이 미리 깔려 있어야 한다.
#   createdb -O dibs dibs_shadow && psql -d dibs_shadow -c "CREATE EXTENSION pg_trgm; CREATE EXTENSION pgcrypto;"
SHADOW_DATABASE_URL="postgresql://dibs:dibs@localhost:5432/dibs_shadow"



# ─── 인증 — 구글 OAuth (D-09: 구글 로그인만) ─────────────────────────────────
# [필수] Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# [필수] 구글 콘솔의 "승인된 리디렉션 URI" 와 **문자 하나까지 같아야** 한다.
#   전역 prefix 가 api 이므로 /auth/... 가 아니라 /api/auth/... 다. 흔한 실수 지점.
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"


# ─── 인증 — JWT ──────────────────────────────────────────────────────────────
# [필수] 16자 이상. 바꾸면 발급된 토큰이 전부 무효가 되어 프론트가 401 루프에 빠진다(로컬스토리지 비우면 풀린다).
JWT_SECRET="dev-only-secret-change-me-32chars"
# [선택] 기본 7d.
JWT_EXPIRES_IN="7d"


# ─── URL / CORS ──────────────────────────────────────────────────────────────
# [필수] 구글 콜백이 토큰을 들고 돌아갈 프론트 주소. CORS 기본 허용 출처이기도 하다.
WEB_APP_URL="http://localhost:3000"
# [선택] 허용 출처를 여러 개 두고 싶을 때 쉼표로. 비우면 WEB_APP_URL 하나만 허용한다.
CORS_ORIGINS=""
# [필수/web] 프론트가 부를 API 주소. NEXT_PUBLIC_ 은 **빌드 시점에 박히므로** 배포마다 다시 빌드해야 한다.
NEXT_PUBLIC_API_URL="http://localhost:3001"


# ─── 이미지 업로드 (Vercel Blob) ─────────────────────────────────────────────
# [선택] 없으면 시설·이벤트 이미지 업로드만 실패한다. 나머지 흐름은 전부 돈다.
BLOB_READ_WRITE_TOKEN=""


# ─── 이메일 (Resend, D-10) ───────────────────────────────────────────────────
# [선택] 없으면 아웃박스(EmailDelivery)에는 쌓이고 실제 발송만 안 된다. 앱 내 알림은 정상.
RESEND_API_KEY=""
# [선택] 기본 "Dibs <no-reply@dibs.example>". 실제로 보내려면 Resend 에서 검증한 도메인이어야 한다.
EMAIL_FROM="Dibs <no-reply@dibs.example>"
# [보안] Resend 배달 이벤트 웹훅(POST /api/webhooks/resend)의 Svix 서명 시크릿.
#   비어 있으면 웹훅을 **전부 401 로 거절**한다 — 아무나 배달 상태를 조작하는 것보다 낫다.
#   개발 중 웹훅을 안 쓸 거면 비워둬도 된다.
RESEND_WEBHOOK_SECRET=""


# ─── 크론 (Vercel Cron) ──────────────────────────────────────────────────────
# [보안] 16자 이상. Vercel Cron 이 `Authorization: Bearer <값>` 으로 보낸다.
#   비어 있으면 CronGuard 가 **모든 크론 호출을 401 로 거절**한다(fail closed).
#   → 안 채우면 만료 스위퍼·순위 확정이 조용히 멈춘 것처럼 보인다. 로컬에서 크론을 손으로 때리려면 반드시 채운다.
CRON_SECRET="dev-only-cron-secret-32chars-min"


# ─── 개인정보 해싱 ───────────────────────────────────────────────────────────
# [선택] 입찰 이력의 IP 해시 솔트. 비우면 JWT_SECRET 을 대신 쓴다.
#   운영에서는 반드시 별도 값으로 두고 **바꾸지 않는다** — 바꾸면 과거 해시와 대조가 끊겨 어뷰징 추적이 불가능해진다.
IP_HASH_SALT=""


# ─── 예약금 홀드 (D-05 — 실결제는 범위 밖) ───────────────────────────────────
# [선택] 기본 false. 상태·타이머·테이블만 있고 PG 연동은 없다. true 로 켜도 결제는 일어나지 않는다.
DEPOSIT_HOLD_ENABLED="false"
# [선택] 기본 10. 이벤트별 설정이 없을 때의 기본 윈도우(분).
DEPOSIT_HOLD_WINDOW_MINUTES="10"


# ─── 문서 ────────────────────────────────────────────────────────────────────
# [선택] "false" 일 때만 Swagger 를 끈다. 그 외 값(미설정 포함)이면 /api/docs 가 열린다.
#   운영 배포에서는 명시적으로 "false" 를 넣는 것을 권장한다.
SWAGGER_ENABLED="true"


# ─── 시드 (pnpm --filter @dibs/api db:seed) ──────────────────────────────────
# [선택] 운영자 계정은 셀프가입이 불가하므로(D-09) 시드로만 만든다.
#   여기 적은 구글 이메일로 로그인하면 그 계정이 ADMIN 이 된다. 비우면 시드 기본값을 쓴다.
ADMIN_SEED_EMAIL=""
